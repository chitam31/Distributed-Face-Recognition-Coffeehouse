# Sao chép thành .env rồi nạp: set -a; source client/.env; set +a      (Windows PowerShell: đặt $env:RABBIT_HOST=...)
BRANCH_ID=A
RABBIT_HOST=192.168.1.10          # IP máy server chạy docker compose
RABBIT_PORT=5672
RABBIT_USER=branch_a              # tài khoản riêng của chi nhánh (scripts/create_branch_users.sh)
RABBIT_PASS=branch_a_pass
# Bật khi dùng TLS (xem docs/BAO_CAO.md mục Bảo mật):
# RABBIT_TLS=true
# RABBIT_PORT=5671
# RABBIT_CA_FILE=./certs/ca.pem
