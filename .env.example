# Sao chép thành .env (docker compose tự đọc file này)
RABBIT_ADMIN_USER=coffee_admin
RABBIT_ADMIN_PASS=coffee_admin_123
SIM_THRESHOLD=0.45          # chỉnh sau khi chạy tools.eval_threshold
DEMO_DELAY_MS=0             # 4000 khi demo "kill worker"
ORT_THREADS=0               # luồng ONNX mỗi worker; 0=tự động. Chạy nhiều worker 1 máy: đặt 2 (so với số nhân)
QUEUE_TYPE=quorum           # quorum | classic (đổi loại queue phải xoá queue cũ: docker compose down -v)
MYSQL_HOST_PORT=3306       # đổi (vd. 3307) nếu máy đã có MySQL chiếm cổng 3306
PG_HOST_PORT=5432          # đổi (vd. 5433) nếu máy đã có PostgreSQL chiếm cổng 5432
MIN_BLUR_VAR=30            # hạ xuống (vd. 15) nếu webcam của em bị báo 'ảnh quá mờ' oan
MIN_FACE_PX=60
MULTI_FACE_POLICY=largest   # largest = lấy mặt lớn nhất; reject = bắt chụp lại
RABBIT_BIND_IP=              # IP mạng riêng (vd. ZeroTier 10.234.18.42) để chi nhánh ở máy khác nối vào cổng 5672. Để trống = chỉ máy server truy cập (an toàn). KHÔNG đặt 0.0.0.0
# Trang quản trị chỉ đọc (docker-compose.admin.yml, scripts/admin_web.sh): mật khẩu ít nhất 10 ký tự, không có dấu cách,
# không ghi chú trên cùng dòng. Để trống thì trang quản trị không chạy.
ADMIN_PASSWORD=
ADMIN_PORT=8090
